# Supabase config. Copy this file to ".env.local" and fill in your values.
# Both come from your Supabase project dashboard: Settings -> API.
# The anon (public) key is safe to be public; it's protected by Row Level Security.
# NEVER put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
